# Custom Format based on Visual-Studio style.
# The tree is formatted with a pinned clang-format v20, vendored on demand by
# cmake/addclangformat.cmake. Run `cmake --build build --target format` (rewrite)
# or `format-check` (CI gate) — both use that pinned binary, not whatever
# clang-format is on your PATH, so formatting stays reproducible.
# Option reference: https://clang.llvm.org/docs/ClangFormatStyleOptions.html

# Defaults
BasedOnStyle: LLVM
ColumnLimit: 0
IndentWidth: 4
TabWidth: 4
UseTab: Always

# CXX Language
Language: Cpp
AccessModifierOffset: -4
AllowShortIfStatementsOnASingleLine: false
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 4
BreakBeforeBraces: Allman
IndentCaseLabels: true
IndentPPDirectives: AfterHash
NamespaceIndentation: All
DerivePointerAlignment: false
PointerAlignment: Left
# West const: `const T&` / `const char*`, never `T const&` (clang-format >= 14).
QualifierAlignment: Left